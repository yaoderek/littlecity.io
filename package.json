{
  "name": "little-city",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "e2e": "vitest run --project e2e",
    "check": "npm run typecheck && npm run lint && vitest run",
    "check:full": "npm run typecheck && npm run lint && LC_FULL=1 vitest run",
    "shots": "node tools/shots.mjs",
    "inspect": "node tools/inspect.mjs",
    "bench": "node tools/bench.mjs",
    "guide": "node tools/guide.mjs",
    "music": "node tools/music.mjs",
    "seo": "node tools/seo.mjs",
    "indexnow": "node tools/indexnow.mjs",
    "translate": "node tools/translate.mjs",
    "build:forum": "rolldown -c server/rolldown.config.mjs",
    "forum": "npm run build:forum && FORUM_DATA=.context/forum-data PORT=8787 ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin} FORUM_GAME_URL=${FORUM_GAME_URL:-http://127.0.0.1:5173} node --disable-warning=ExperimentalWarning server/dist/forum.mjs",
    "forum:seed": "node tools/forum-seed.mjs"
  },
  "dependencies": {
    "posthog-js": "1.453.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
